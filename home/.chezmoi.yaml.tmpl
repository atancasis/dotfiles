{{- /* Every `chezmoi init` asks again, defaulting to the current value. An empty
       answer always means "keep the default", so "none" turns the hostname,
       signing key or work email off; it is stored as an empty string. */ -}}
{{- $name := get . "name" | default "Arnold Tan Casis" -}}
{{- $email := get . "email" | default "atancasis@gmail.com" -}}
{{- $hostname := "yggdrasil" -}}
{{- if hasKey . "hostname" -}}
{{-   $hostname = get . "hostname" -}}
{{- end -}}
{{- $signingKey := "E0FB94BF79183EDC" -}}
{{- if hasKey . "signingKey" -}}
{{-   $signingKey = get . "signingKey" -}}
{{- end -}}
{{- $extras := true -}}
{{- if hasKey . "extras" -}}
{{-   $extras = get . "extras" -}}
{{- end -}}
{{- $workEmail := get . "workEmail" | default "" -}}
{{- $workSigningKey := get . "workSigningKey" | default "" -}}
{{- $work := ne $workEmail "" -}}
{{- if hasKey . "work" -}}
{{-   $work = get . "work" -}}
{{- end -}}
{{- $personal := true -}}
{{- if hasKey . "personal" -}}
{{-   $personal = get . "personal" -}}
{{- end -}}

{{- $name = promptString "Name" $name -}}
{{- $email = promptString "Email" $email -}}
{{- $hostname = promptString "Hostname, or none to leave it unchanged" ($hostname | default "none") -}}
{{- if eq $hostname "none" }}{{ $hostname = "" }}{{ end -}}
{{- $signingKey = promptString "GPG signing key, or none for unsigned commits" ($signingKey | default "none") -}}
{{- if eq $signingKey "none" }}{{ $signingKey = "" }}{{ end -}}

{{- $extras = promptBool "Install extras (dev tools, containers, desktop apps)" $extras -}}
{{- $work = promptBool "Install work tools (Kubernetes, cloud, Java, VPN)" $work -}}
{{- if $work -}}
{{-   $workEmail = promptString "Work email, or none" ($workEmail | default "none") -}}
{{-   if eq $workEmail "none" }}{{ $workEmail = "" }}{{ end -}}
{{- else -}}
{{-   $workEmail = "" -}}
{{- end -}}
{{- if $workEmail -}}
{{-   $workSigningKey = promptString "Work SSH signing key, or none" ($workSigningKey | default "none") -}}
{{-   if eq $workSigningKey "none" }}{{ $workSigningKey = "" }}{{ end -}}
{{-   if hasPrefix "~/" $workSigningKey }}{{ $workSigningKey = joinPath .chezmoi.homeDir (trimPrefix "~/" $workSigningKey) }}{{ end -}}
{{-   $workSigningKey = trimSuffix ".pub" $workSigningKey -}}
{{- else -}}
{{-   $workSigningKey = "" -}}
{{- end -}}
{{- $personal = promptBool "Install personal apps (media, messaging, VPN)" $personal -}}
data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}
  hostname: {{ $hostname | quote }}
  signingKey: {{ $signingKey | quote }}
  extras: {{ $extras }}
  work: {{ $work }}
  workEmail: {{ $workEmail | quote }}
  workSigningKey: {{ $workSigningKey | quote }}
  personal: {{ $personal }}
