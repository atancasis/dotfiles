[user]
	name = {{ .name }}
	email = {{ .workEmail | default .email }}
{{- if .workSigningKey }}
	signingkey = {{ .workSigningKey }}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" }}
[commit]
	gpgsign = true
{{- else if .signingKey }}
	signingkey = {{ .signingKey }}
[commit]
	gpgsign = true
{{- end }}
[init]
	defaultBranch = main
[alias]
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
[pull]
	rebase = true
[rebase]
	autoStash = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[help]
	autocorrect = prompt
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
{{- if .workEmail }}
[includeIf "gitdir:{{ .chezmoi.workingTree }}/"]
	path = ~/.config/git/personal
{{- end }}
