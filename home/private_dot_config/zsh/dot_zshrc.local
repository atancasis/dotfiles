# GNU make 4 as `make`; Homebrew installs it as `gmake`.
[[ -d $HOMEBREW_PREFIX/opt/make/libexec/gnubin ]] && path=($HOMEBREW_PREFIX/opt/make/libexec/gnubin $path)

export EDITOR="nvim"
export VISUAL="nvim"

# less stays the pager; bat only renders man pages. col -bx strips the
# overstrike formatting from macOS man, which bat would otherwise print.
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

(( $+commands[kubecolor] )) && alias kubectl="kubecolor"

# zsh4humans already sets most options, including unlimited, shared history.
# These add to it.
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate.
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry.
setopt CORRECT                   # Try to correct the spelling of commands.

# Skip history entries where the first word is not a known command (catches typos)
zshaddhistory() {
  emulate -L zsh
  setopt extendedglob
  local -a words=( ${(z)1} )
  local i=1
  while (( i <= $#words )) && [[ ${words[i]} == [A-Za-z_][A-Za-z0-9_]#=* ]]; do
    (( i++ ))
  done
  (( i > $#words )) && return 0
  whence -- "${words[i]}" >/dev/null 2>&1
}

# Image sizes
imgsizes() {
  (
  echo "FILE SIZE PIXELS"
  for f in **/*.(png|jpg|jpeg|heic)(N); do
    dims=$(sips -g pixelWidth -g pixelHeight "$f" 2>/dev/null | awk '/pixel/ {print $2}' | xargs)
    [[ -n $dims ]] || continue
    dims="${dims/ /x}"
    fsize=$(stat -f "%z" "$f" 2>/dev/null)
    [[ -n $fsize ]] || continue
    if (( fsize > 1048576 )); then
      fsize=$(echo "scale=1; $fsize/1048576" | bc)MB
    else
      fsize=$(echo "scale=1; $fsize/1024" | bc)KB
    fi
    echo "$f $fsize $dims"
  done
  ) | column -t
}

# ASCII punctuation in the clipboard, except em dashes
sanitize-clipboard() {
  pbpaste | perl -CSDA -pe '
    s/[\x{2018}\x{2019}\x{201A}\x{201B}]/\x27/g;
    s/[\x{201C}\x{201D}\x{201E}\x{201F}]/"/g;
    s/[\x{2010}\x{2011}\x{2012}\x{2013}\x{2212}]/-/g;
    s/\x{2026}/.../g;
    s/[\x{00A0}\x{2007}\x{2009}\x{202F}]/ /g;
    s/[\x{00AD}\x{200B}\x{200C}\x{200D}\x{2060}\x{FEFF}]//g;
  ' | pbcopy
}

# Back up the history once a day and keep a week of backups. Uses zsh
# builtins so a new shell doesn't fork when today's backup already exists.
() {
  zmodload -F zsh/datetime b:strftime p:EPOCHSECONDS
  local dir=${HISTFILE:h}/backups today
  strftime -s today %Y-%m-%d $EPOCHSECONDS
  [[ -f $dir/zsh_history.$today ]] && return
  mkdir -p -- $dir && cp -- $HISTFILE $dir/zsh_history.$today 2>/dev/null
  rm -f -- $dir/zsh_history.*(N.m+7)
}
